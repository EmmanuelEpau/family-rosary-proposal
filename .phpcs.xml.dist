<?xml version="1.0"?>
<ruleset name="Family Rosary">
    <description>WordPress VIP and PHP 8.3 compatibility checks for Family Rosary.</description>
    <file>wordpress/family-rosary</file>
    <arg name="extensions" value="php"/>
    <arg name="severity" value="1"/>
    <arg value="s"/>
    <config name="testVersion" value="8.3"/>
    <rule ref="WordPress-VIP-Go"/>
    <rule ref="PHPCompatibilityWP"/>
    <!-- These exact project functions share the removed FAM extension's prefix. -->
    <rule ref="PHPCompatibility.Extensions.RemovedExtensions">
        <properties>
            <property name="functionWhitelist" type="array">
                <element value="family_rosary_document_url"/>
                <element value="family_rosary_documents"/>
                <element value="family_rosary_language"/>
                <element value="family_rosary_language_links"/>
                <element value="family_rosary_language_messages"/>
                <element value="family_rosary_language_picker"/>
                <element value="family_rosary_languages"/>
                <element value="family_rosary_legacy_assets"/>
                <element value="family_rosary_legacy_page_aliases"/>
                <element value="family_rosary_live_api"/>
                <element value="family_rosary_live_channel"/>
                <element value="family_rosary_live_day"/>
                <element value="family_rosary_live_key"/>
                <element value="family_rosary_live_lock"/>
                <element value="family_rosary_live_payload"/>
                <element value="family_rosary_live_programs"/>
                <element value="family_rosary_live_resolve"/>
                <element value="family_rosary_live_search_budget"/>
                <element value="family_rosary_live_timestamp"/>
                <element value="family_rosary_live_unlock"/>
                <element value="family_rosary_local_legacy_page"/>
                <element value="family_rosary_localized_title"/>
                <element value="family_rosary_native_review"/>
                <element value="family_rosary_prepare_drafts"/>
                <element value="family_rosary_preview_link"/>
                <element value="family_rosary_preview_page"/>
                <element value="family_rosary_preview_parent"/>
                <element value="family_rosary_preview_route"/>
                <element value="family_rosary_preview_routes"/>
                <element value="family_rosary_preview_schedule_url"/>
                <element value="family_rosary_public_language_links"/>
                <element value="family_rosary_requested_article"/>
                <element value="family_rosary_requested_document"/>
                <element value="family_rosary_resource_article_url"/>
                <element value="family_rosary_resource_articles"/>
                <element value="family_rosary_review_language_url"/>
                <element value="family_rosary_site_templates"/>
                <element value="family_rosary_translate"/>
                <element value="family_rosary_translation_key"/>
            </property>
        </properties>
    </rule>
</ruleset>
